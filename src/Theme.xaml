<ResourceDictionary xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
                    xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml">
    <Color x:Key="AccentColor">#34BCFC</Color>
    <SolidColorBrush x:Key="AccentBrush" Color="{StaticResource AccentColor}"/>
    <LinearGradientBrush x:Key="AccentGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#3DC5FF" Offset="0"/>
        <GradientStop Color="#1BA6EA" Offset="1"/>
    </LinearGradientBrush>
    <LinearGradientBrush x:Key="AccentHoverGradientBrush" StartPoint="0,0" EndPoint="1,1">
        <GradientStop Color="#57CFFF" Offset="0"/>
        <GradientStop Color="#27B2F4" Offset="1"/>
    </LinearGradientBrush>
    <SolidColorBrush x:Key="AccentDeepBrush" Color="#087FAF"/>
    <SolidColorBrush x:Key="AccentWashBrush" Color="#E8F7FF"/>
    <SolidColorBrush x:Key="CanvasBrush" Color="#F4F8FC"/>
    <SolidColorBrush x:Key="SurfaceBrush" Color="White"/>
    <SolidColorBrush x:Key="InkBrush" Color="#1F3548"/>
    <SolidColorBrush x:Key="MutedBrush" Color="#7E93A6"/>
    <SolidColorBrush x:Key="BorderBrush" Color="#DDE8F2"/>
    <Style TargetType="Window">
        <Setter Property="FontFamily" Value="Microsoft YaHei UI"/>
        <Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="Background" Value="{StaticResource CanvasBrush}"/>
    </Style>
    <Style TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid x:Name="CheckRoot" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="18"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Height="22" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border x:Name="CheckFocus" BorderBrush="Transparent" BorderThickness="1.5" CornerRadius="7" Margin="-2,0"/>
                    <Border x:Name="CheckFrame" Height="18" Background="White" BorderBrush="#C3D5E4" BorderThickness="1" CornerRadius="5.5"/>
                    <Path x:Name="CheckMark" Data="M3.5,10 L7.2,13.5 L14.3,6" Stroke="White" StrokeThickness="1.9" StrokeStartLineCap="Round" StrokeEndLineCap="Round" StrokeLineJoin="Round" Visibility="Collapsed"/>
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="8,0,0,0" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="CheckFrame" Property="Background" Value="#21A5E8"/>
                    <Setter TargetName="CheckFrame" Property="BorderBrush" Value="#21A5E8"/>
                    <Setter TargetName="CheckMark" Property="Visibility" Value="Visible"/>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="CheckFrame" Property="BorderBrush" Value="#21A5E8"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="CheckFocus" Property="BorderBrush" Value="#7ED4FC"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="CheckRoot" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="SwitchCheckBox" TargetType="CheckBox">
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="MinHeight" Value="26"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="CheckBox">
            <Grid x:Name="SwitchRoot" Background="Transparent">
                <Grid.ColumnDefinitions><ColumnDefinition Width="40"/><ColumnDefinition Width="*"/></Grid.ColumnDefinitions>
                <Grid Height="26" VerticalAlignment="Center" IsHitTestVisible="False">
                    <Border x:Name="SwitchFocus" CornerRadius="13" BorderThickness="1.5" Margin="-2,0" BorderBrush="Transparent"/>
                    <Border x:Name="SwitchTrack" Height="22" Background="#C7D6E4" CornerRadius="11"/>
                    <Ellipse Width="18" Height="18" Fill="White" HorizontalAlignment="Left" Margin="2,0,0,0">
                        <Ellipse.Effect><DropShadowEffect BlurRadius="4" ShadowDepth="1" Opacity="0.16" Color="#103652"/></Ellipse.Effect>
                        <Ellipse.RenderTransform><TranslateTransform x:Name="SwitchThumb"/></Ellipse.RenderTransform>
                    </Ellipse>
                </Grid>
                <ContentPresenter Grid.Column="1" Margin="9,0,0,0" RecognizesAccessKey="True" HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="{TemplateBinding VerticalContentAlignment}"/>
            </Grid>
            <ControlTemplate.Triggers>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="SwitchTrack" Property="Background" Value="{StaticResource AccentGradientBrush}"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchThumb" Storyboard.TargetProperty="X" To="18" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="SwitchThumb" Storyboard.TargetProperty="X" To="0" Duration="0:0:0.18"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="SwitchTrack" Property="Opacity" Value="0.88"/></Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="SwitchFocus" Property="BorderBrush" Value="{StaticResource AccentBrush}"/></Trigger>
                <Trigger Property="IsEnabled" Value="False"><Setter TargetName="SwitchRoot" Property="Opacity" Value="0.4"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="Button">
        <Setter Property="Background" Value="White"/>
        <Setter Property="Foreground" Value="#3E5D75"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/>
        <Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="13,9"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Center"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="ChromeScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#EAF6FF"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#B4DDF6"/>
                            <Setter Property="Foreground" Value="#087FAF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="#D6EFFE"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.36"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#34BCFC"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="AccentButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="{StaticResource AccentGradientBrush}"/>
        <Setter Property="BorderBrush" Value="#2AB4F4"/>
        <Setter Property="Foreground" Value="#0D344A"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform><ScaleTransform x:Name="ChromeScale" ScaleX="1" ScaleY="1"/></Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="Background" Value="{StaticResource AccentHoverGradientBrush}"/>
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#57CFFF"/>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Setter TargetName="Chrome" Property="Opacity" Value="0.9"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.14"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsEnabled" Value="False"><Setter TargetName="Chrome" Property="Opacity" Value="0.38"/></Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#087FAF"/></Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="KnownButton" TargetType="Button" BasedOn="{StaticResource AccentButton}">
        <Setter Property="Background">
            <Setter.Value>
                <LinearGradientBrush StartPoint="0,0" EndPoint="1,1">
                    <GradientStop Color="#25C38B" Offset="0"/>
                    <GradientStop Color="#149D6C" Offset="1"/>
                </LinearGradientBrush>
            </Setter.Value>
        </Setter>
        <Setter Property="BorderBrush" Value="#149D6C"/>
        <Setter Property="Foreground" Value="White"/>
    </Style>
    <Style x:Key="VagueButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FFF6E5"/>
        <Setter Property="BorderBrush" Value="#F3CB80"/>
        <Setter Property="Foreground" Value="#B45309"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="ForgottenButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Background" Value="#FFF0F2"/>
        <Setter Property="BorderBrush" Value="#F5AEB8"/>
        <Setter Property="Foreground" Value="#C82842"/>
        <Setter Property="FontWeight" Value="SemiBold"/>
    </Style>
    <Style x:Key="MorphemeChipButton" TargetType="Button">
        <Setter Property="Background" Value="#F0FAFF"/>
        <Setter Property="BorderBrush" Value="#46BEF6"/>
        <Setter Property="BorderThickness" Value="1.5"/>
        <Setter Property="Padding" Value="11,6"/>
        <Setter Property="Cursor" Value="Hand"/>
        <Setter Property="HorizontalContentAlignment" Value="Left"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="FocusVisualStyle" Value="{x:Null}"/>
        <Setter Property="Template">
            <Setter.Value>
                <ControlTemplate TargetType="Button">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}"
                            BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="10" Padding="{TemplateBinding Padding}" RenderTransformOrigin="0.5,0.5">
                        <Border.RenderTransform>
                            <TransformGroup>
                                <ScaleTransform x:Name="ChromeScale" ScaleX="1" ScaleY="1"/>
                                <TranslateTransform x:Name="ChromeLift" Y="0"/>
                            </TransformGroup>
                        </Border.RenderTransform>
                        <ContentPresenter HorizontalAlignment="{TemplateBinding HorizontalContentAlignment}" VerticalAlignment="Center"/>
                    </Border>
                    <ControlTemplate.Triggers>
                        <Trigger Property="IsMouseOver" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#24B4F5"/>
                            <Setter TargetName="Chrome" Property="Background" Value="#EBF8FF"/>
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeLift" Storyboard.TargetProperty="Y" To="-2" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeLift" Storyboard.TargetProperty="Y" To="0" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsPressed" Value="True">
                            <Trigger.EnterActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleX" To="0.97" Duration="0:0:0.08"/>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleY" To="0.97" Duration="0:0:0.08"/>
                            </Storyboard></BeginStoryboard></Trigger.EnterActions>
                            <Trigger.ExitActions><BeginStoryboard><Storyboard>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleX" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                                <DoubleAnimation Storyboard.TargetName="ChromeScale" Storyboard.TargetProperty="ScaleY" To="1" Duration="0:0:0.16"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation>
                            </Storyboard></BeginStoryboard></Trigger.ExitActions>
                        </Trigger>
                        <Trigger Property="IsKeyboardFocused" Value="True">
                            <Setter TargetName="Chrome" Property="BorderBrush" Value="#087FAF"/>
                        </Trigger>
                    </ControlTemplate.Triggers>
                </ControlTemplate>
            </Setter.Value>
        </Setter>
    </Style>
    <Style x:Key="RelationToggle" TargetType="ToggleButton">
        <Setter Property="Foreground" Value="#3E6786"/><Setter Property="Background" Value="#F3F9FE"/>
        <Setter Property="BorderBrush" Value="#DFECF6"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="9,5"/><Setter Property="FontSize" Value="11"/>
        <Setter Property="Cursor" Value="Hand"/><Setter Property="Margin" Value="0,0,6,0"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ToggleButton">
            <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <StackPanel Orientation="Horizontal">
                    <ContentPresenter VerticalAlignment="Center"/>
                    <TextBlock x:Name="Arrow" Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="8" Margin="8,0,0,0" VerticalAlignment="Center" RenderTransformOrigin="0.5,0.5">
                        <TextBlock.RenderTransform><RotateTransform x:Name="ArrowRotate" Angle="0"/></TextBlock.RenderTransform>
                    </TextBlock>
                </StackPanel>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#E7F5FE"/><Setter TargetName="Chrome" Property="BorderBrush" Value="#B8E0F7"/></Trigger>
                <Trigger Property="IsChecked" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="#E2F4FF"/>
                    <Setter TargetName="Chrome" Property="BorderBrush" Value="#8BD7FC"/>
                    <Setter Property="Foreground" Value="#087FAF"/>
                    <Trigger.EnterActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="180" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.EnterActions>
                    <Trigger.ExitActions><BeginStoryboard><Storyboard><DoubleAnimation Storyboard.TargetName="ArrowRotate" Storyboard.TargetProperty="Angle" To="0" Duration="0:0:0.2"><DoubleAnimation.EasingFunction><CubicEase EasingMode="EaseOut"/></DoubleAnimation.EasingFunction></DoubleAnimation></Storyboard></BeginStoryboard></Trigger.ExitActions>
                </Trigger>
                <Trigger Property="IsKeyboardFocused" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#34BCFC"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style x:Key="RelationDetails" TargetType="Border">
        <Setter Property="Background" Value="#F7FBFF"/><Setter Property="CornerRadius" Value="12"/>
        <Setter Property="BorderBrush" Value="#DCEBF6"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="16,12,16,6"/><Setter Property="Margin" Value="0,10,0,0"/>
        <Setter Property="Visibility" Value="Collapsed"/>
        <Style.Triggers><DataTrigger Binding="{Binding IsChecked}" Value="True"><Setter Property="Visibility" Value="Visible"/></DataTrigger></Style.Triggers>
    </Style>
    <Style x:Key="RelationGroupTitle" TargetType="TextBlock">
        <Setter Property="Foreground" Value="#3C6888"/><Setter Property="FontWeight" Value="SemiBold"/>
        <Setter Property="FontSize" Value="12"/><Setter Property="Margin" Value="0,0,0,5"/>
    </Style>
    <Style x:Key="TitleButton" TargetType="Button" BasedOn="{StaticResource {x:Type Button}}">
        <Setter Property="Width" Value="34"/><Setter Property="Height" Value="34"/>
        <Setter Property="BorderThickness" Value="0"/><Setter Property="Padding" Value="0"/>
        <Setter Property="Background" Value="Transparent"/><Setter Property="Foreground" Value="#6F8498"/>
    </Style>
    <Style x:Key="WindowButton" TargetType="Button" BasedOn="{StaticResource TitleButton}">
        <Setter Property="Width" Value="42"/><Setter Property="Height" Value="38"/>
    </Style>
    <Style x:Key="CloseWindowButton" TargetType="Button" BasedOn="{StaticResource WindowButton}">
        <Style.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter Property="Foreground" Value="#D84C58"/></Trigger></Style.Triggers>
    </Style>
    <Style TargetType="TextBox">
        <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="12,10"/><Setter Property="VerticalContentAlignment" Value="Center"/>
        <Setter Property="SelectionBrush" Value="#A9DFFC"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="TextBox">
                <Border x:Name="FocusHalo" BorderBrush="Transparent" BorderThickness="2" CornerRadius="11" Margin="-2">
                    <Border x:Name="Chrome" Background="{TemplateBinding Background}" BorderBrush="{TemplateBinding BorderBrush}" BorderThickness="{TemplateBinding BorderThickness}" CornerRadius="9">
                        <ScrollViewer x:Name="PART_ContentHost" Focusable="False"/>
                    </Border>
                </Border>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#B4DAF2"/></Trigger>
                    <Trigger Property="IsKeyboardFocused" Value="True">
                        <Setter TargetName="Chrome" Property="BorderBrush" Value="{StaticResource AccentBrush}"/>
                        <Setter TargetName="FocusHalo" Property="BorderBrush" Value="#DDF3FE"/>
                    </Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="PasswordBox"><Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="{StaticResource InkBrush}"/><Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="Padding" Value="10"/></Style>
    <Style TargetType="ComboBox">
        <Setter Property="Background" Value="White"/><Setter Property="Foreground" Value="#47647B"/>
        <Setter Property="BorderBrush" Value="{StaticResource BorderBrush}"/><Setter Property="BorderThickness" Value="1"/>
        <Setter Property="Padding" Value="10,6"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="VerticalContentAlignment" Value="Center"/><Setter Property="ScrollViewer.HorizontalScrollBarVisibility" Value="Disabled"/>
        <Setter Property="Template">
            <Setter.Value><ControlTemplate TargetType="ComboBox">
                <Grid>
                    <ToggleButton Focusable="False" IsChecked="{Binding IsDropDownOpen, RelativeSource={RelativeSource TemplatedParent}, Mode=TwoWay}" ClickMode="Press">
                        <ToggleButton.Template><ControlTemplate TargetType="ToggleButton">
                            <Border x:Name="Chrome" Background="{Binding Background,RelativeSource={RelativeSource AncestorType=ComboBox}}" BorderBrush="#DDE8F1" BorderThickness="1" CornerRadius="8">
                                <TextBlock Text="&#xE70D;" FontFamily="Segoe MDL2 Assets" FontSize="10" Foreground="#7693A9" HorizontalAlignment="Right" VerticalAlignment="Center" Margin="0,0,11,0"/>
                            </Border>
                            <ControlTemplate.Triggers><Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="BorderBrush" Value="#34BCFC"/></Trigger></ControlTemplate.Triggers>
                        </ControlTemplate></ToggleButton.Template>
                    </ToggleButton>
                    <ContentPresenter x:Name="SelectionContent" Content="{TemplateBinding SelectionBoxItem}" ContentTemplate="{TemplateBinding SelectionBoxItemTemplate}" ContentTemplateSelector="{TemplateBinding ItemTemplateSelector}" Margin="10,0,29,0" VerticalAlignment="Center" IsHitTestVisible="False"/>
                    <TextBox x:Name="PART_EditableTextBox" Style="{x:Null}" Visibility="Collapsed" IsReadOnly="{TemplateBinding IsReadOnly}" Background="Transparent" BorderThickness="0" Padding="0" Margin="10,0,29,0" VerticalContentAlignment="Center" Foreground="{TemplateBinding Foreground}" SelectionBrush="#A9DFFC"/>
                    <Popup x:Name="PART_Popup" IsOpen="{TemplateBinding IsDropDownOpen}" Placement="Bottom" AllowsTransparency="True" Focusable="False" PopupAnimation="Fade">
                        <Border Background="White" BorderBrush="#D5E6F3" BorderThickness="1" CornerRadius="9" MinWidth="{Binding ActualWidth,RelativeSource={RelativeSource TemplatedParent}}" MaxHeight="320" Margin="0,4,0,0" Padding="4">
                            <Border.Effect><DropShadowEffect BlurRadius="14" ShadowDepth="4" Opacity="0.1" Color="#144466"/></Border.Effect>
                            <ScrollViewer CanContentScroll="True"><ItemsPresenter KeyboardNavigation.DirectionalNavigation="Contained"/></ScrollViewer>
                        </Border>
                    </Popup>
                </Grid>
                <ControlTemplate.Triggers>
                    <Trigger Property="IsEditable" Value="True"><Setter TargetName="SelectionContent" Property="Visibility" Value="Collapsed"/><Setter TargetName="PART_EditableTextBox" Property="Visibility" Value="Visible"/><Setter Property="IsTabStop" Value="False"/></Trigger>
                    <Trigger Property="IsEnabled" Value="False"><Setter Property="Opacity" Value="0.45"/></Trigger>
                </ControlTemplate.Triggers>
            </ControlTemplate></Setter.Value>
        </Setter>
    </Style>
    <Style TargetType="ComboBoxItem">
        <Setter Property="Padding" Value="10,8"/><Setter Property="HorizontalContentAlignment" Value="Stretch"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ComboBoxItem">
            <Border x:Name="Chrome" CornerRadius="6" Padding="{TemplateBinding Padding}" Background="Transparent"><ContentPresenter/></Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsHighlighted" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EAF7FF"/></Trigger>
                <Trigger Property="IsSelected" Value="True"><Setter Property="Foreground" Value="#087FAF"/><Setter Property="FontWeight" Value="SemiBold"/><Setter TargetName="Chrome" Property="Background" Value="#E3F5FF"/></Trigger>
            </ControlTemplate.Triggers>
        </ControlTemplate></Setter.Value></Setter>
    </Style>
    <Style TargetType="ListBoxItem">
        <Setter Property="Padding" Value="11,9"/><Setter Property="Margin" Value="0,2"/>
        <Setter Property="FontFamily" Value="Segoe UI"/><Setter Property="FontSize" Value="14"/>
        <Setter Property="HorizontalContentAlignment" Value="Stretch"/><Setter Property="Cursor" Value="Hand"/>
        <Setter Property="Template"><Setter.Value><ControlTemplate TargetType="ListBoxItem">
            <Border x:Name="Chrome" Background="Transparent" CornerRadius="8" Padding="{TemplateBinding Padding}">
                <Grid>
                    <Border x:Name="AccentBar" Width="3" CornerRadius="2" Background="#2BB6F7" HorizontalAlignment="Left" Margin="-8,2,0,2" Opacity="0"/>
                    <ContentPresenter/>
                </Grid>
            </Border>
            <ControlTemplate.Triggers>
                <Trigger Property="IsMouseOver" Value="True"><Setter TargetName="Chrome" Property="Background" Value="#EEF8FF"/></Trigger>
                <Trigger Property="IsSelected" Value="True">
                    <Setter TargetName="Chrome" Property="Background" Value="#E2F4FF"/>
                    <Setter Property="Foreground" Value="#087FAF"/>
                    <Setter Property="FontWeight" Value="SemiBold"/>
                    <Setter TargetName="AccentBar" Property="Opacity" Value="1"/>
                </Trigger>
            </ControlTemplate.Triggers>
